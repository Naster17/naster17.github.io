---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Icon } from "astro-icon/components";
import MainCard from "@/components/MainCard.astro";
import GitHubStats from "@/components/mdx/GitHubStats.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import dayjs from "@utils/dayjs";
import { DATE_FORMAT } from "@config";

const posts = await getCollection("blog", ({ data }) => !data.draft);
const sortedPosts = posts.sort((a, b) => 
  new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
);
const latestPost = sortedPosts[0];
const latestPostDate = latestPost ? dayjs(latestPost.data.pubDate).format(DATE_FORMAT) : "";
---

<BaseLayout title="Home">
  <MainCard
    title="Welcome!"
    description="My personal blog and portfolio website"
    textOverlay="HOME"
    infoIcon="lucide:info"
  >
  <div class="space-y-8">
      <!-- Hero Section -->
      <section class="py-6">
        <div class="flex flex-col items-center text-center">
          <h1 class="text-4xl font-bold mb-4 bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent leading-loose">
            Personal Blog | Portfolio
          </h1>
          <p class="text-xl text-base-content/80 max-w-3xl mb-8">
            My personal blog with author's topics, and also my portfolio.
          </p>
        </div>

        <h2 class="text-2xl font-bold mb-4 flex items-center gap-2">
          <Icon name="lucide:compass" class="w-6 h-6 text-primary" />
          <span>Explore</span>
        </h2>

        <div class="flex flex-col gap-4 justify-center w-full">
            <a href="/blog" class="group block bg-base-100 border border-base-300 rounded-xl overflow-hidden hover:border-primary hover:shadow-lg hover:shadow-primary/10 transition-all duration-300">
              <div class="flex flex-col lg:flex-row">
                <div class="flex-1 p-4 md:p-5">
                  <div class="flex items-center justify-center">
                    <h3 class="text-lg md:text-xl font-bold px-8 py-2 bg-primary rounded-full group-hover:bg-primary/80 transition-colors text-primary-content">
                      My Blog
                    </h3>
                  </div>
                  <p class="text-sm text-base-content/70 mt-2 text-center">
                    Read articles about programming, embedded systems, hardware, and more.
                  </p>
                </div>
                <div class="relative lg:w-48 h-24 lg:h-auto overflow-hidden group">
                  <div class="absolute inset-0 bg-black/0 group-hover:bg-black/60 z-10 transition-all duration-300 flex items-center justify-center opacity-0 group-hover:opacity-100">
                    <Icon name="lucide:arrow-right" class="w-8 h-8 text-white" />
                  </div>
                  <div class="w-full h-full bg-base-200 flex items-center justify-center">
                    <Icon name="lucide:book-open" class="w-10 h-10 text-base-content/30" />
                  </div>
                </div>
              </div>
            </a>
            <a href="/about" class="group block bg-base-100 border border-base-300 rounded-xl overflow-hidden hover:border-primary hover:shadow-lg hover:shadow-primary/10 transition-all duration-300">
              <div class="flex flex-col lg:flex-row">
                <div class="flex-1 p-4 md:p-5">
                  <div class="flex items-center justify-center">
                    <h3 class="text-lg md:text-xl font-bold px-8 py-2 bg-secondary rounded-full group-hover:bg-secondary/80 transition-colors text-secondary-content">
                      About Me
                    </h3>
                  </div>
                  <p class="text-sm text-base-content/70 mt-2 text-center">
                    Learn more about me, my skills, tech stack, and interests.
                  </p>
                </div>
                <div class="relative lg:w-48 h-24 lg:h-auto overflow-hidden group">
                  <div class="absolute inset-0 bg-black/0 group-hover:bg-black/60 z-10 transition-all duration-300 flex items-center justify-center opacity-0 group-hover:opacity-100">
                    <Icon name="lucide:arrow-right" class="w-8 h-8 text-white" />
                  </div>
                  <div class="w-full h-full bg-base-200 flex items-center justify-center">
                    <Icon name="lucide:user" class="w-10 h-10 text-base-content/30" />
                  </div>
                </div>
              </div>
            </a>
          </div>
      </section>

      <!-- Latest Blog Post -->
      {latestPost && (
        <section class="py-6">
          <h2 class="text-2xl font-bold mb-4 flex items-center gap-2">
            <Icon name="lucide:file-text" class="w-6 h-6 text-primary" />
            <span>Latest Article</span>
          </h2>
          <a href={`/blog/${latestPost.slug}`} class="block group bg-base-100 border border-base-300 rounded-xl overflow-hidden hover:border-primary hover:shadow-lg hover:shadow-primary/10 transition-all duration-300">
            <div class="flex flex-col lg:flex-row">
              <!-- Content -->
              <div class="flex-1 p-4 md:p-6">
                <div class="mb-3">
                  <span class="badge badge-primary">{latestPostDate}</span>
                  {latestPost.data.badge && (
                    <span class="badge badge-secondary ml-2">{latestPost.data.badge}</span>
                  )}
                </div>
                <h3 class="text-xl md:text-2xl font-bold mb-2 group-hover:text-primary transition-colors">
                  {latestPost.data.title}
                </h3>
                <p class="text-sm text-base-content/70 mb-4 line-clamp-2">
                  {latestPost.data.description}
                </p>
                <div class="flex flex-wrap gap-2">
                  {latestPost.data.categories?.map((cat: string) => (
                    <span class="btn btn-xs btn-category">
                      <Icon name="lucide:folder" class="w-3 h-3" />
                      <span>{cat}</span>
                    </span>
                  ))}
                  {latestPost.data.tags?.map((tag: string) => (
                    <span class="btn btn-xs btn-tag">
                      <Icon name="lucide:tag" class="w-3 h-3" />
                      <span>{tag}</span>
                    </span>
                  ))}
                </div>
              </div>
              <!-- Image -->
              {latestPost.data.image && (
                <div class="relative lg:w-2/5 aspect-video lg:aspect-auto overflow-hidden group">
                  <div class="absolute inset-0 bg-black/0 group-hover:bg-black/60 z-10 transition-all duration-300 flex items-center justify-center opacity-0 group-hover:opacity-100">
                    <Icon name="lucide:arrow-right" class="w-12 h-12 text-white" />
                  </div>
                  <Image
                    src={latestPost.data.image}
                    alt={latestPost.data.title}
                    width={800}
                    height={400}
                    format="webp"
                    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                  />
                </div>
              )}
            </div>
          </a>
        </section>
      )}

      <!-- GitHub Stats -->
      <section class="py-6">
        <h2 class="text-2xl font-bold mb-6 flex items-center gap-2">
          <Icon name="lucide:github" class="w-6 h-6 text-primary" />
          <span>Latest Repo</span>
        </h2>
        <GitHubStats username="Naster17" repositoryName="esp-ninja" showLanguages={true} showContributors={true} />
      </section>
  </div>
  </MainCard>
</BaseLayout>
